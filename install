#!/usr/bin/env bash
set -ex

if ! command -v mise >/dev/null 2>&1; then
    for arg in "$@"; do
        case "$arg" in
            -n|--dry-run|--help|-h)
                printf '%s\n' 'Install mise first: https://mise.jdx.dev/getting-started.html' >&2
                exit 1
                ;;
        esac
    done
    curl -fsSL https://mise.run | sh
fi

mise trust
for arg in "$@"; do
    case "$arg" in
        -n|--dry-run|-h|--help)
            exec mise bootstrap "$@"
            ;;
    esac
done
mise bootstrap "$@"

# Bash aliases, functions, and prompt.
cat >> ~/.bashrc <<'DOTFILES_SHELL'
alias v='nvim'
alias vi='nvim'

dockerexec() {
    docker exec -it "$1" /bin/bash
}

klog() {
    stern -t "$1" | grep -v health
}

if [ -n "${TMUX:-}" ]; then
    export TERM=tmux-256color
fi

parse_git_branch() {
    git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
}
PS1='\[\033[32m\]\w\[\033[33m\]$(parse_git_branch)\[\033[00m\] $ '
bind 'set bell-style none'
DOTFILES_SHELL
